{
  "name": "golden-grace-legacy",
  "private": true,
  "version": "1.1.1",
  "description": "Premium South African Artisanal Products",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:assets": "node scripts/check-static-assets.mjs",
    "check:orphans": "node scripts/check-static-assets.mjs --orphans",
    "check:security": "node scripts/check-security.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "node --test",
    "validate": "npm run lint && npm test && npm run check:assets && npm run check:security && npm run build",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/lab": "^0.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "vite": "^7.2.4"
  }
}
