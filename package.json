{
  "name": "golden-grace-legacy",
  "private": true,
  "version": "1.1.1",
  "description": "Premium South African Artisanal Products",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:assets": "node scripts/check-static-assets.mjs",
    "check:orphans": "node scripts/check-static-assets.mjs --orphans",
    "check:security": "node scripts/check-security.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "node --test --experimental-test-coverage",
    "validate": "npm run lint && npm test && npm run check:assets && npm run check:security && npm run build",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/lab": "^0.1.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
